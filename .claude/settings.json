{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git switch *)",
      "Bash(npm test *)", "Bash(npm run *)", "Bash(npm ci)",
      "Bash(npx tsc *)", "Bash(npx vitest *)", "Bash(npx eslint *)", "Bash(npx prettier *)",
      "Bash(npx drizzle-kit generate *)",
      "Bash(docker compose up *)", "Bash(docker compose ps *)", "Bash(docker compose logs *)",
      "Bash(docker compose build *)", "Bash(docker compose restart *)", "Bash(docker compose stop *)"
    ],
    "ask": [
      "Bash(git push *)", "Bash(git merge *)", "Bash(git rebase *)", "Bash(git checkout *)",
      "Bash(git restore *)", "Bash(git stash *)", "Bash(git tag *)", "Bash(git revert *)",
      "Bash(git commit*--amend*)", "Bash(gh *)",
      "Bash(npm install *)", "Bash(npm i *)", "Bash(npm uninstall *)", "Bash(npm update *)",
      "Bash(npm run db*)",
      "Bash(docker compose down *)", "Bash(docker compose exec *)", "Bash(docker compose run *)",
      "Bash(docker compose rm *)", "Bash(docker exec *)",
      "Bash(bash -c *)", "Bash(sh -c *)",
      "Edit(/server/drizzle/**)", "Edit(/server/src/calculs/annexe.test.ts)",
      "Edit(/docker-compose.yml)", "Edit(/CLAUDE.md)", "Edit(/docs/cahier-des-charges.md)"
    ],
    "deny": [
      "Bash(git push*--force*)", "Bash(git push* -f*)", "Bash(git push*--delete*)",
      "Bash(git push*--no-verify*)", "Bash(git commit*--no-verify*)",
      "Bash(git reset*--hard*)", "Bash(git clean*)", "Bash(git checkout .)",
      "Bash(git branch* -D*)", "Bash(git add* -f*)", "Bash(git add*--force*)",
      "Bash(git filter-branch*)", "Bash(git filter-repo*)", "Bash(git reflog expire*)",
      "Bash(git gc*--prune*)", "Bash(git stash clear*)", "Bash(git config --global*)",
      "Bash(git -C *)", "Bash(git -c *)",

      "Bash(npm publish*)", "Bash(npm link*)", "Bash(npm config*)", "Bash(npm cache clean*)",
      "Bash(npm * -g*)", "Bash(npm * --global*)", "Bash(npm audit fix*--force*)",
      "Bash(yarn*)", "Bash(pnpm*)",
      "Bash(npx drizzle-kit push*)", "Bash(npx drizzle-kit drop*)",

      "Bash(docker compose down*-v*)", "Bash(docker-compose down*-v*)",
      "Bash(docker volume rm*)", "Bash(docker volume prune*)", "Bash(docker system prune*)",
      "Bash(docker container prune*)", "Bash(docker image prune*)", "Bash(docker network prune*)",
      "Bash(docker rmi*)", "Bash(docker run*--privileged*)", "Bash(docker login*)",
      "Bash(docker push*)", "Bash(docker context*)", "Bash(docker compose config*)",
      "Bash(*DROP DATABASE*)", "Bash(*DROP TABLE*)", "Bash(*DROP SCHEMA*)", "Bash(*TRUNCATE TABLE*)",
      "Bash(*drop database*)", "Bash(*drop table*)", "Bash(*drop schema*)", "Bash(*truncate table*)",
      "Bash(dropdb*)",

      "Bash(rm -rf*)", "Bash(rm -fr*)", "Bash(sudo*)", "Bash(chmod -R*)",
      "Bash(curl*)", "Bash(wget*)",

      "PowerShell(Remove-Item* -r*)", "PowerShell(Invoke-Expression*)",
      "PowerShell(Invoke-WebRequest*)", "PowerShell(Set-ExecutionPolicy*)",
      "PowerShell(git push*--force*)", "PowerShell(git push* -f*)", "PowerShell(git reset*--hard*)",
      "PowerShell(docker compose down*-v*)", "PowerShell(docker volume rm*)",
      "PowerShell(docker volume prune*)", "PowerShell(docker system prune*)",

      "Read(.env)", "Read(.env.*)", "Read(!.env.example)",
      "Read(**/*.key)", "Read(**/*-key.pem)",
      "Edit(/data/**)", "Edit(/.claude/settings.json)", "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",

      "WebFetch(domain:vinted.fr)", "WebFetch(domain:*.vinted.fr)",
      "WebFetch(domain:vinted.com)", "WebFetch(domain:*.vinted.com)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/formater.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
