# Modèle de configuration — à copier en « .env » puis à adapter.
# ⚠️ Ce fichier ne contient que des valeurs FICTIVES. Le vrai .env n'est jamais commité.

# --- Base de données PostgreSQL ---
POSTGRES_USER=vinted
POSTGRES_PASSWORD=remplacez-moi-par-un-mot-de-passe-long
POSTGRES_DB=vinted_helper
# Port de la base sur votre PC (à changer seulement s'il est déjà pris)
POSTGRES_PORT=5432

# --- Application ---
# Port de l'application sur votre PC : http://localhost:3000
PORT=3000
# Adresse IP du PC sur le Wi-Fi de la maison (pour le téléphone, docs/guides/telephone-https.md). Ex. 192.168.1.20
IP_PC=192.168.1.20

# --- Compte unique : utilisé UNIQUEMENT au premier démarrage pour créer le compte ---
# (ensuite, changez le mot de passe dans l'application : Réglages ; 8 caractères minimum)
COMPTE_IDENTIFIANT=mon-identifiant
COMPTE_MOT_DE_PASSE_INITIAL=remplacez-moi

# --- IA Google Gemini (génération d'annonce, lecture d'étiquette) — voir docs/guides/ia-gemini.md ---
# Clé gratuite à créer sur Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=votre-cle-gemini
# Nom du modèle : modifiable ici sans toucher au code (Google retire régulièrement ses anciens modèles).
# Exemple : gemini-2.5-flash — vérifiez la liste des modèles disponibles dans Google AI Studio.
GEMINI_MODELE=nom-du-modele-gemini

# --- Serveur OVH uniquement (docs/guides/mise-en-ligne-ovh.md) — laisser vide sur le PC ---
# Adresse publique de l'application, ex. vps-1234abcd.vps.ovh.net (ou votre nom de domaine)
DOMAINE=
# Sur le serveur : COMPOSE_FILE=docker-compose.yml:docker-compose.ovh.yml (écrit par scripts/ovh/installer.sh)
