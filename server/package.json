{
  "name": "@vinted-helper/server",
  "version": "1.31.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:couverture": "vitest run --coverage",
    "test:navigateur": "vitest run -c vitest.navigateur.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=../.env --import tsx src/base/migrer-cli.ts",
    "reset-password": "node dist/commandes/reinitialiser-mot-de-passe.js",
    "import-tableur": "node dist/commandes/importer-tableur.js",
    "photos:sans-metadonnees": "node dist/commandes/photos-sans-metadonnees.js",
    "doc:categories": "node --import tsx src/commandes/generer-doc-categories.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.6",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
