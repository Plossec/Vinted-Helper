{
  "manifest_version": 3,
  "name": "Vinted Helper — publication",
  "version": "1.5.0",
  "description": "Publie sur Vinted les annonces demandées dans Vinted Helper, dans votre propre session Chrome.",
  "icons": { "16": "icone-16.png", "48": "icone-48.png", "128": "icone-128.png" },
  "permissions": ["storage", "alarms", "tabs", "notifications"],
  "host_permissions": ["https://www.vinted.fr/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://www.vinted.fr/*"],
      "js": ["selecteurs.js", "contenu.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Vinted Helper — publication" },
  "options_page": "options.html"
}
